{
"manifest_version": 3,
"name": "Victory - Safe Browsing & Accountability",
"description": "An Accountability tool designed to support users to reduce compulsive porn consumption and improve digital wellbeing",
"version": "1.0",
"permissions": [
"tabs",
"storage",
"notifications",
"alarms",
"identity",
"declarativeNetRequest",
"declarativeNetRequestWithHostAccess"
],

"host_permissions": [
"<all_urls>"
],
"background": {
"service_worker": "background.js"
},
"action": {
"default_popup": "popup/popup.html",
"default_icon": {
"16": "Icons/favicon-16x16.png",
"48": "Icons/android-chrome-192x192.png",
"128": "Icons/android-chrome-192x192.png"
}
},
"web_accessible_resources": [
{
"resources": [
"sites.json",
"blocked.html",
"popup/popup.html",
"popup/popupp.html",
"popup/popup.js"
],
"matches": ["<all_urls>"]
}
]}