{
  "manifest_version": 3,
  "name": "LaviX - Safe Browsing & Accountability",
  "description": "An accountability tool designed to support users in reducing compulsive porn consumption and improving digital wellbeing.",
  "version": "1.0",
  

  "permissions": [
    "tabs",
    "storage",
    "identity",
    "alarms",
    "notifications",
    "declarativeNetRequest"
  ],

  "oauth2": {
    "client_id": "650310438797-vb3tl8g9mfntcu6hb1lj8r2q6ql0qlet.apps.googleusercontent.com",
    "scopes": [
      "openid",
      "email",
      "profile"
    ]
  },

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "icons": {
    "16": "Icons/favicon-16x16.png",
    "48": "Icons/android-chrome-192x192.png",
    "128": "Icons/android-chrome-192x192.png"
  },

  "action": {
    "default_popup": "popup/popupp.html",
    "default_icon": {
      "16": "Icons/favicon-16x16.png",
      "48": "Icons/android-chrome-192x192.png",
      "128": "Icons/android-chrome-192x192.png"
    }
  },

  "web_accessible_resources": [
    {
      "resources": [
        "sites.json",
        "blocked.html",
        "blocked.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],

  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "lavix_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },

  "externally_connectable": {
    "matches": [
      "https://www.purpose-partner.org/*"
    ]
  }
}