{
  "manifest_version": 3,
  "name": "Victory - Safe Browsing & Accountability",
  "version": "1.0",

  "permissions": [
    "tabs",
    "storage",
    "identity",
    "alarms",
    "notifications",
    "declarativeNetRequest",
    "webNavigation"
  ],

  "oauth2": {
    "client_id": "650310438797-vb3tl8g9mfntcu6hb1lj8r2q6ql0qlet.apps.googleusercontent.com",
    "scopes": [
      "openid",
      "email",
      "profile"
    ]
  },

  "host_permissions": [
    "<all_urls>",
    "https://firestore.googleapis.com/*",
    "https://identitytoolkit.googleapis.com/*",
    "https://securetoken.googleapis.com/*"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "icons": {
    "16": "Icons/favicon-16x16.png",
    "48": "Icons/android-chrome-192x192.png",
    "128": "Icons/android-chrome-192x192.png"
  },

  "action": {
    "default_popup": "popup/popupp.html",
    "default_icon": {
      "16": "Icons/favicon-16x16.png",
      "48": "Icons/android-chrome-192x192.png",
      "128": "Icons/android-chrome-192x192.png"
    }
  },

  "web_accessible_resources": [
    {
      "resources": [
        "sites.json",
        "blocked.html",
        "blocked.js",
        "popup/popup.html",
       "popup/popupp.html",
        "popup/popup.js"
             ],
      "matches": ["<all_urls>"]
    }
  ],

  "externally_connectable": {
    "matches": [
      "http://localhost:5173/*",
      "http://localhost:4173/*",
      "https://victory-fb944.firebaseapp.com/*"
    ],
    "declarative_net_request": {
  "rule_resources": [
    {
      "id": "victory_rules",
      "enabled": true,
      "path": "rules.json"
    }
  ]
}
  }
}